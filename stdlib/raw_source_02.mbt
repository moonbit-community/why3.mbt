        b"(** {1 Option type} *)\n\nmodule Option\n\n  type option 'a = None | Some 'a\n\n  let predicate is_none (o: option 'a)\n    ensures { result <-> o = None }\n  = match o with None -> true | Some _ -> false end\n\nend\n\nmodule Map\n\n  use Option\n\n  function map (f: 'a -> 'b) (o: option 'a) : option 'b\n  = match o with None -> None | Some x -> Some (f x) end\n\nend\n",
